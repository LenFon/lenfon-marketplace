<?xml version="1.0" encoding="utf-8"?>
<!-- 解决方案级 NuGet 源配置（随仓库提交，保证还原行为可复现）。
     <clear /> 排除机器级/用户级源（local、VS Offline Packages 等），仅走下方显式声明的官方源。
     需要私有/内网源（如公司源、D:\packages）或自行维护的镜像时，
     在 <packageSources> 内追加 <add key="名称" value="地址"/>。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

<prism:PrismApplication x:Class="__APP_NAME__.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MD + MahApps 统一主题：按 PrimaryColor/SecondaryColor 自动生成 MahApps 画刷
                     （AccentColorBrush / HighlightBrush 等），MetroWindow 等控件沿用 MD 配色，无需手工映射 -->
                <materialDesign:MahAppsBundledTheme BaseTheme="Light"
                                                    PrimaryColor="DeepPurple"
                                                    SecondaryColor="Lime" />

                <!-- MahApps.Metro 基础样式（MetroWindow 窗体必需） -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />

                <!-- Material Design 3 默认样式 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Material Design × MahApps 桥接：聚合字典（Themes 文件夹下，引用时忽略大小写），
                     一次性合并字体 / Flyout / TextBox / PasswordBox / RangeSlider / NumericUpDown /
                     WindowCommands 等全部 MahApps 控件桥接样式 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.MahApps;component/Themes/MaterialDesignTheme.MahApps.Defaults.xaml" />

                <!-- 共享值转换器字典（全局可用，View 里用 StaticResource 引用） -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
